<style>
.side-quests{margin:0 0 44px;text-align:left;font-family:"Segoe UI","Microsoft YaHei",sans-serif}.side-quests-heading{display:flex;align-items:baseline;gap:13px;margin-bottom:15px;color:#496353}.side-quests-heading>span{font-size:17px;font-weight:600;letter-spacing:2px}.side-quests-heading>small{font-size:11px;color:#949987}.side-quests-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.side-quests .side-quest{display:flex;align-items:center;gap:16px;padding:21px 18px;border:1px solid #dedeca;border-radius:10px;background:#f3eddd;text-decoration:none;color:#3a5b48;transition:transform .2s,box-shadow .2s}.side-quests .side-quest:hover{color:#3a5b48;transform:translateY(-3px);box-shadow:0 9px 20px #354f3a12;border-color:#aeb99c}.side-quest>svg{width:84px;height:88px;flex-shrink:0}.side-quest div>small{font-size:9px;color:#96866a;letter-spacing:1px}.side-quest strong{display:block;font-size:18px;font-weight:600;line-height:1.5;margin-top:4px}.side-quest p{font-size:11px;line-height:1.8;color:#8a917e;margin:6px 0 9px}.side-quest div>span{font-size:11px;color:#607954}.side-quests .side-quest-hot100{background:#eef0e5}.side-quest:focus-visible{outline:3px solid #ae7654;outline-offset:4px}@media(max-width:767px){.side-quests{margin-bottom:32px}.side-quests-grid{grid-template-columns:1fr;gap:12px}.side-quest>svg{width:75px;height:75px}.side-quests .side-quest{padding:14px 17px}.side-quest strong{font-size:17px}.side-quest p{margin:4px 0 6px}.side-quests-heading{gap:9px}.side-quests-heading>small{font-size:10px}}@media(prefers-reduced-motion:reduce){.side-quests .side-quest{transition:none}}
</style>
